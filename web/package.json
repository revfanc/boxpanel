    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "^31.0.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-compiler": "npm:typescript@7.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
