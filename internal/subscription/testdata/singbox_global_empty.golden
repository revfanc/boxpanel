{
  "dns": {
    "final": "dns-remote",
    "rules": [
      {
        "action": "predefined",
        "query_type": [
          "AAAA"
        ],
        "rcode": "NOERROR"
      }
    ],
    "servers": [
      {
        "detour": "proxy",
        "path": "/dns-query",
        "server": "1.1.1.1",
        "tag": "dns-remote",
        "type": "https"
      },
      {
        "path": "/dns-query",
        "server": "223.5.5.5",
        "tag": "dns-local",
        "type": "https"
      },
      {
        "tag": "dns-bootstrap",
        "type": "local"
      }
    ]
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_fakeip": false
    }
  },
  "inbounds": [
    {
      "address": [
        "172.19.0.1/30"
      ],
      "auto_route": true,
      "strict_route": true,
      "tag": "tun-in",
      "type": "tun"
    },
    {
      "listen": "127.0.0.1",
      "listen_port": 2080,
      "tag": "mixed-in",
      "type": "mixed"
    }
  ],
  "log": {
    "level": "warn"
  },
  "outbounds": [
    {
      "default": "direct",
      "outbounds": [
        "direct"
      ],
      "tag": "proxy",
      "type": "selector"
    },
    {
      "tag": "direct",
      "type": "direct"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": "dns-local",
    "final": "proxy",
    "rule_set": [],
    "rules": [
      {
        "action": "sniff"
      },
      {
        "action": "hijack-dns",
        "protocol": "dns"
      },
      {
        "action": "route",
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "action": "reject"
      }
    ]
  }
}
