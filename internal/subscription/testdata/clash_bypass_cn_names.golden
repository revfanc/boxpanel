allow-lan: false
dns:
  default-nameserver:
    - https://223.5.5.5/dns-query
  enable: true
  enhanced-mode: fake-ip
  fake-ip-filter:
    - '*.lan'
    - '*.local'
    - localhost.ptlink
    - localhost.ptlogin2.qq.com
    - time.*.com
    - ntp.*.com
    - +.pool.ntp.org
    - +.msftconnecttest.com
    - +.msftncsi.com
    - captive.apple.com
    - rule-set:geosite-cn
  fake-ip-range: 198.18.0.1/16
  follow-rule: true
  ipv6: false
  nameserver:
    - https://223.5.5.5/dns-query
    - https://doh.pub/dns-query
  nameserver-policy:
    +.msftconnecttest.com:
      - https://1.1.1.1/dns-query
    +.msftncsi.com:
      - https://1.1.1.1/dns-query
    +.pool.ntp.org:
      - https://1.1.1.1/dns-query
    captive.apple.com:
      - https://1.1.1.1/dns-query
    ntp.*.com:
      - https://1.1.1.1/dns-query
    rule-set:geosite-cn:
      - https://223.5.5.5/dns-query
      - https://doh.pub/dns-query
    rule-set:geosite-geolocation-!cn:
      - https://1.1.1.1/dns-query
    time.*.com:
      - https://1.1.1.1/dns-query
  proxy-server-nameserver:
    - https://223.5.5.5/dns-query
    - https://doh.pub/dns-query
  respect-rules: true
ipv6: false
log-level: warning
mixed-port: 7890
mode: rule
proxies:
  - client-fingerprint: chrome
    flow: xtls-rprx-vision
    name: Reality · 443
    network: tcp
    packet-encoding: xudp
    port: 443
    reality-opts:
      public-key: eNXgbb5tlL6g2fud8-bam8Tz5tLHPhwxkOsxcjDnqFs
      short-id: 0123456789abcdef
    server: 203.0.113.8
    servername: www.example.com
    tls: true
    type: vless
    udp: true
    uuid: aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa
  - alpn:
      - h3
    fingerprint: 6f75dac014e40140bd72c4e9838e1c57df00be3b431fc4dc54a84908783a0b91
    name: Hysteria2 · 8443
    password: test-only-p@ss:/?#密
    port: 8443
    server: 203.0.113.8
    skip-cert-verify: false
    sni: www.bing.com
    type: hysteria2
  - client-fingerprint: chrome
    flow: xtls-rprx-vision
    name: Reality · 443 (2)
    network: tcp
    packet-encoding: xudp
    port: 9443
    reality-opts:
      public-key: eNXgbb5tlL6g2fud8-bam8Tz5tLHPhwxkOsxcjDnqFs
      short-id: 0123456789abcdef
    server: 203.0.113.8
    servername: www.example.com
    tls: true
    type: vless
    udp: true
    uuid: aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa
proxy-groups:
  - name: 节点选择
    proxies:
      - 自动选择
      - 手动选择
    type: select
  - hidden: true
    interval: 300
    lazy: true
    name: 自动选择
    proxies:
      - Reality · 443
      - Hysteria2 · 8443
      - Reality · 443 (2)
    tolerance: 50
    type: url-test
    url: https://www.gstatic.com/generate_204
  - name: 手动选择
    proxies:
      - Reality · 443
      - Hysteria2 · 8443
      - Reality · 443 (2)
    type: select
rule-providers:
  geoip-cn:
    behavior: ipcidr
    format: yaml
    interval: 86400
    proxy: 节点选择
    type: http
    url: https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geoip/cn.yaml
  geosite-cn:
    behavior: domain
    format: yaml
    interval: 86400
    proxy: 节点选择
    type: http
    url: https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/cn.yaml
  geosite-geolocation-!cn:
    behavior: domain
    format: yaml
    interval: 86400
    proxy: 节点选择
    type: http
    url: https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/geolocation-!cn.yaml
rules:
  - IP-CIDR,1.1.1.1/32,节点选择,no-resolve
  - IP-CIDR,223.5.5.5/32,DIRECT,no-resolve
  - DOMAIN,doh.pub,DIRECT
  - IP-CIDR,0.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,10.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,100.64.0.0/10,DIRECT,no-resolve
  - IP-CIDR,127.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,169.254.0.0/16,DIRECT,no-resolve
  - IP-CIDR,172.16.0.0/12,DIRECT,no-resolve
  - IP-CIDR,192.168.0.0/16,DIRECT,no-resolve
  - IP-CIDR,224.0.0.0/4,DIRECT,no-resolve
  - IP-CIDR,240.0.0.0/4,DIRECT,no-resolve
  - IP-CIDR6,::/128,DIRECT,no-resolve
  - IP-CIDR6,::1/128,DIRECT,no-resolve
  - IP-CIDR6,fc00::/7,DIRECT,no-resolve
  - IP-CIDR6,fe80::/10,DIRECT,no-resolve
  - IP-CIDR6,ff00::/8,DIRECT,no-resolve
  - RULE-SET,geosite-cn,DIRECT
  - RULE-SET,geoip-cn,DIRECT,no-resolve
  - MATCH,节点选择
