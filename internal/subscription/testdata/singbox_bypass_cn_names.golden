      "server_port": 9443,
      "tag": "Reality · 443 (2)",
      "tls": {
        "enabled": true,
        "reality": {
          "enabled": true,
          "public_key": "eNXgbb5tlL6g2fud8-bam8Tz5tLHPhwxkOsxcjDnqFs",
          "short_id": "0123456789abcdef"
        },
        "server_name": "www.example.com",
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
