      },
      "type": "vless",
      "uuid": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa"
    },
    {
      "tag": "direct",
      "type": "direct"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": "dns-local",
    "final": "proxy",
    "rule_set": [
      {
        "format": "binary",
        "http_client": {
          "detour": "proxy"
        },
        "tag": "geosite-cn",
        "type": "remote",
        "update_interval": "1d",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/cn.srs"
      },
      {
        "format": "binary",
        "http_client": {
          "detour": "proxy"
        },
        "tag": "geoip-cn",
        "type": "remote",
        "update_interval": "1d",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geoip/cn.srs"
      }
    ],
    "rules": [
      {
        "action": "sniff"
      },
      {
        "action": "hijack-dns",
        "protocol": "dns"
      },
      {
        "action": "route",
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "action": "route",
        "outbound": "direct",
        "rule_set": [
          "geosite-cn"
        ]
      },
      {
        "action": "resolve",
        "server": "dns-remote"
      },
      {
        "action": "route",
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "action": "route",
        "outbound": "direct",
        "rule_set": [
          "geoip-cn"
        ]
      }
    ]
  }
}
