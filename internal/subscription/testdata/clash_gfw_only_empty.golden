allow-lan: false
dns:
  default-nameserver:
    - https://223.5.5.5/dns-query
  enable: true
  enhanced-mode: fake-ip
  fake-ip-filter:
    - '*.lan'
    - '*.local'
    - localhost.ptlink
    - localhost.ptlogin2.qq.com
    - time.*.com
    - ntp.*.com
    - +.pool.ntp.org
    - +.msftconnecttest.com
    - +.msftncsi.com
    - captive.apple.com
  fake-ip-range: 198.18.0.1/16
  follow-rule: true
  ipv6: false
  nameserver:
    - https://223.5.5.5/dns-query
    - https://doh.pub/dns-query
  nameserver-policy:
    rule-set:geosite-gfw:
      - https://1.1.1.1/dns-query
  proxy-server-nameserver:
    - https://223.5.5.5/dns-query
    - https://doh.pub/dns-query
  respect-rules: true
ipv6: false
log-level: warning
mixed-port: 7890
mode: rule
proxies: []
proxy-groups:
  - name: 节点选择
    proxies:
      - 自动选择
      - DIRECT
    type: select
  - interval: 300
    name: 自动选择
    proxies:
      - REJECT
    type: url-test
    url: https://www.gstatic.com/generate_204
rule-providers:
  geosite-gfw:
    behavior: domain
    format: yaml
    interval: 86400
    proxy: 节点选择
    type: http
    url: https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/gfw.yaml
rules:
  - IP-CIDR,1.1.1.1/32,REJECT,no-resolve
  - IP-CIDR,223.5.5.5/32,DIRECT,no-resolve
  - DOMAIN,doh.pub,DIRECT
  - IP-CIDR,0.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,10.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,100.64.0.0/10,DIRECT,no-resolve
  - IP-CIDR,127.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,169.254.0.0/16,DIRECT,no-resolve
  - IP-CIDR,172.16.0.0/12,DIRECT,no-resolve
  - IP-CIDR,192.168.0.0/16,DIRECT,no-resolve
  - IP-CIDR,224.0.0.0/4,DIRECT,no-resolve
  - IP-CIDR,240.0.0.0/4,DIRECT,no-resolve
  - IP-CIDR6,::/128,DIRECT,no-resolve
  - IP-CIDR6,::1/128,DIRECT,no-resolve
  - IP-CIDR6,fc00::/7,DIRECT,no-resolve
  - IP-CIDR6,fe80::/10,DIRECT,no-resolve
  - IP-CIDR6,ff00::/8,DIRECT,no-resolve
  - RULE-SET,geosite-gfw,REJECT
  - MATCH,REJECT
