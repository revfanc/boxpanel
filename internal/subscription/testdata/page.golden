<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>boxpanel · 订阅中心</title>
<style>
 
:root {
  color-scheme: light;
  --background: oklch(1 0 0);
  --foreground: oklch(0.145 0 0);
  --card: oklch(1 0 0);
  --card-foreground: oklch(0.145 0 0);
  --primary: oklch(0.205 0 0);
  --primary-foreground: oklch(0.985 0 0);
  --muted: oklch(0.97 0 0);
  --muted-foreground: oklch(0.556 0 0);
  --border: oklch(0.922 0 0);
  --input: oklch(0.922 0 0);
  --ring: oklch(0.708 0 0);
  --radius: 0.625rem;
}
@media (prefers-color-scheme: dark) {
  :root {
    color-scheme: dark;
    --background: oklch(0.145 0 0);
    --foreground: oklch(0.985 0 0);
    --card: oklch(0.205 0 0);
    --card-foreground: oklch(0.985 0 0);
    --primary: oklch(0.922 0 0);
    --primary-foreground: oklch(0.205 0 0);
    --muted: oklch(0.269 0 0);
    --muted-foreground: oklch(0.708 0 0);
    --border: oklch(1 0 0 / 10%);
    --input: oklch(1 0 0 / 15%);
    --ring: oklch(0.556 0 0);
  }
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--background); color: var(--foreground); font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; font-size: 14px; line-height: 1.6; -webkit-text-size-adjust: 100%; }
main { max-width: 32rem; margin: 0 auto; padding: 32px 16px; overflow-wrap: anywhere; }
h1,h2,p { margin: 0; }
h1 { font-size: 24px; font-weight: 600; letter-spacing: -.025em; }
h2 { font-size: 16px; font-weight: 600; }
header { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 24px; }
header > div { min-width: 0; }
.eyebrow { font-size: 12px; margin-bottom: 6px; }
.muted,footer { color: var(--muted-foreground); }
.badge { flex-shrink: 0; padding: 3px 10px; border: 1px solid var(--border); border-radius: 999px; background: var(--muted); font-size: 12px; font-weight: 500; }
.card { min-width: 0; margin-top: 16px; padding: 20px; border: 1px solid var(--border); border-radius: calc(var(--radius) * 1.4); background: var(--card); color: var(--card-foreground); }
.usage { margin: 16px 0 12px; font-variant-numeric: tabular-nums; }
.usage strong { font-size: 28px; line-height: 1.3; font-weight: 600; letter-spacing: -.025em; }
progress { display: block; appearance: none; width: 100%; height: 8px; overflow: hidden; border: 0; border-radius: 999px; background: var(--muted); color: var(--primary); }
progress::-webkit-progress-bar { background: var(--muted); border-radius: 999px; }
progress::-webkit-progress-value { background: var(--primary); border-radius: 999px; }
progress::-moz-progress-bar { background: var(--primary); border-radius: 999px; }
.expiry { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--border); font-size: 13px; }
.qr { width: fit-content; max-width: 100%; margin: 20px auto; padding: 12px; border-radius: var(--radius); background: #fff; }
.qr img { display: block; width: 232px; max-width: 100%; height: auto; }
label { display: block; margin-bottom: 6px; font-weight: 500; }
.copy-row { display: flex; min-width: 0; gap: 8px; }
input { min-width: 0; width: 100%; flex: 1; border: 1px solid var(--input); border-radius: var(--radius); padding: 10px 12px; background: var(--background); color: var(--foreground); font: inherit; font-size: 16px; }
button,.button { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 10px 14px; border: 1px solid var(--border); border-radius: var(--radius); color: var(--foreground); background: var(--card); font: inherit; font-weight: 500; text-decoration: none; cursor: pointer; }
button { flex-shrink: 0; }
button:hover,.button:hover { filter: brightness(.92); }
button:focus-visible,a:focus-visible,input:focus-visible,summary:focus-visible { outline: 2px solid var(--ring); outline-offset: 3px; }
button:disabled { opacity: .6; cursor: wait; }
.primary { background: var(--primary); color: var(--primary-foreground); border-color: transparent; }
.imports { display: grid; gap: 10px; margin: 16px 0 24px; }
.clients { padding: 0; margin: 12px 0 0; list-style: none; }
.clients li { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 0; border-top: 1px solid var(--border); }
.clients li > div { min-width: 0; }
.clients small { display: block; color: var(--muted-foreground); }
.clients a { flex-shrink: 0; color: var(--foreground); font-size: 12px; text-underline-offset: 4px; padding: 8px 0; }
summary { cursor: pointer; font-weight: 500; }
.format { margin-top: 20px; }
.hint { margin-top: 10px; font-size: 12px; }
.feedback:empty { display: none; }
footer { padding: 24px 4px 0; font-size: 12px; line-height: 1.8; }
footer p + p { margin-top: 8px; }
</style>
</head>
<body>
<main>
  <header>
    <div><p class="eyebrow muted">订阅中心</p><h1>boxpanel</h1><p class="muted">alice</p></div>
    <span class="badge">正常</span>
  </header>
  <section class="card" aria-labelledby="usage-title">
    <h2 id="usage-title">流量用量</h2>
    <p class="usage"><strong>10.50 GB</strong> <span class="muted">/ 100.00 GB</span></p>
    <progress max="100" value="10.5" aria-label="已用流量" aria-valuetext="10.50 GB / 100.00 GB"></progress>
    <div class="expiry"><div><p class="muted">到期</p><p>2026-12-09（UTC）</p></div><p class="muted">剩余 30 天</p></div>
  </section>
  <section class="card" aria-labelledby="subscription-title">
    <h2 id="subscription-title">订阅地址</h2><p class="muted hint">扫描二维码或复制订阅地址，导入客户端。</p>
    <div class="qr"><img width="256" height="256" alt="订阅二维码" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAQAAAAEAAQMAAABmvDolAAAABlBMVEX///8AAABVwtN&#43;AAACOElEQVR42uyYPbLjIBCEP5UCQo7AUbjYK/3UXoyj6AiEBJR6a0Be&#43;9Xb3GLXEyhwfcmYnqYZPvWp/7ImSTqdqt9LJEgiKEf7NQ0EFGABaWsfn5z2HAE/FBCUF6jeemXKsdjH&#43;r4b4OxAYD6wLk4GBRJeUgUvJ&#43;XxAGBxaW4nFjafCH&#43;R3JuBPrypDe98LD4VA35M970BALC/fnOCVamE86ed3hyYCnNelSqTRJBUeuubT/cBdEi72lkwm0XqWDNOvzLjADjhTyJ&#43;c4mw&#43;X4gTpWBgElH9Rux&#43;l2tbC6UWq/jAMB8XWrE61Lj6vU2wFQew2Fuekxqbv8quREAQHkt0SwoVRbaXEQ9JTcGEGwkVL2s9gzgk44vn24DTCW04ZU2mM2MCouXhQbGAeixHliIhJMW8NM3Ix0BONpIwFQivcOzHRb3AaaCcvssoGO64sGLkQ4CzBbVlCephv0y0hIqIwE6ALDpvqIQrWHuBVyKam6/9OvKKg8FyBQVZamToMylqC&#43;fBgJKzw&#43;zXVytw8KaYwn1VkAA&#43;p3KrI3oWip&#43;KmoEAKisUjVFEXapsBALowFzhojfzYIkdZV9T8V3B2y6zUh7dm5qa8DrC&#43;XtwJ&#43;MwOLULKjlNbuPBwIeW1blRq2P1d9gQAEWqEC0DhuA&#43;7Erfi/Q95N0C5LSQ1F&#43;OIDYPLS2VNxT5zYgQMVehCam5qa8ZLk7AMBCrP4ESaYoiO4ZcoYAri2r8tQCZ6Y/Bp87kBGAT33qH6vfAwDCDBL1MypdUgAAAABJRU5ErkJggg=="></div>
    <label for="auto">订阅地址</label>
    <div class="copy-row"><input id="auto" type="text" readonly value="https://panel.example.com:2053/subscribe123/test-only-subscription-token" spellcheck="false" autocomplete="off"><button type="button" data-copy="auto" aria-label="复制 订阅地址">复制</button></div>
    <p class="hint muted">也可以长按或选中地址，手动复制。</p>
  </section>
  <section class="card" aria-labelledby="import-title">
    <h2 id="import-title">一键导入</h2>
    <div class="imports"><a class="button primary" href="sing-box://import-remote-profile?url=https%3A%2F%2Fpanel.example.com%3A2053%2Fsubscribe123%2Ftest-only-subscription-token%3Fformat%3Dsingbox#boxpanel" rel="noreferrer">导入到 sing-box</a><a class="button primary" href="clash://install-config?name=boxpanel&amp;url=https%3A%2F%2Fpanel.example.com%3A2053%2Fsubscribe123%2Ftest-only-subscription-token%3Fformat%3Dclash" rel="noreferrer">导入到 Clash / mihomo</a></div>
    <h2>推荐客户端</h2>
    <ul class="clients">
      <li><div><strong>Clash Verge Rev</strong><small>Windows / macOS / Linux</small></div><a href="https://github.com/clash-verge-rev/clash-verge-rev/releases" target="_blank" rel="noopener noreferrer" aria-label="官方下载 Clash Verge Rev">官方下载</a></li>
      <li><div><strong>sing-box for Android</strong><small>Android</small></div><a href="https://github.com/SagerNet/sing-box/releases" target="_blank" rel="noopener noreferrer" aria-label="官方下载 sing-box for Android">官方下载</a></li>
      <li><div><strong>sing-box MT</strong><small>iOS</small></div><a href="https://apps.apple.com/us/app/sing-box-mt/id6785326793" target="_blank" rel="noopener noreferrer" aria-label="官方下载 sing-box MT">官方下载</a></li>
    </ul>
  </section>
  <details class="card"><summary>其他格式</summary>
    <div class="format"><label for="singbox">JSON 订阅</label><div class="copy-row"><input id="singbox" type="text" readonly value="https://panel.example.com:2053/subscribe123/test-only-subscription-token?format=singbox" spellcheck="false" autocomplete="off"><button type="button" data-copy="singbox" aria-label="复制 JSON 订阅">复制</button></div></div>
    <div class="format"><label for="clash">YAML 订阅</label><div class="copy-row"><input id="clash" type="text" readonly value="https://panel.example.com:2053/subscribe123/test-only-subscription-token?format=clash" spellcheck="false" autocomplete="off"><button type="button" data-copy="clash" aria-label="复制 YAML 订阅">复制</button></div></div>
    <div class="format"><label for="base64">通用 base64 URI 订阅</label><div class="copy-row"><input id="base64" type="text" readonly value="https://panel.example.com:2053/subscribe123/test-only-subscription-token?format=base64" spellcheck="false" autocomplete="off"><button type="button" data-copy="base64" aria-label="复制 通用 base64 URI 订阅">复制</button></div></div>
  </details>
  <p id="copy-feedback" class="feedback hint" role="status" aria-live="polite"></p>
  <footer><p>sing-box 客户端需 1.14 或更新。通用 URI 不含分流规则，请在客户端内选择「绕过大陆」等规则。</p><p>请妥善保存订阅链接，不要公开分享；链接失效时请联系管理员。</p></footer>
</main>
<script nonce="fixed-test-nonce">
(() => {
  const copied = "已复制";
  const failed = "复制失败，请长按或选中地址手动复制。";
  const feedback = document.getElementById('copy-feedback');
  document.querySelectorAll('[data-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
      const input = document.getElementById(button.dataset.copy);
      const original = button.textContent;
      button.disabled = true;
      try {
        try {
          await navigator.clipboard.writeText(input.value);
        } catch {
          
          input.focus();
          input.select();
          if (!document.execCommand('copy')) throw new Error('copy');
        }
        button.textContent = copied;
        feedback.textContent = copied;
        window.setTimeout(() => { button.textContent = original; button.disabled = false; }, 2000);
      } catch {
        button.disabled = false;
        input.focus();
        input.select();
        feedback.textContent = failed;
      }
    });
  });
})();
</script>
</body>
</html>
