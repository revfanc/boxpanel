{
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "dns-local"
      }
    ],
    "final": "dns-local"
  },
  "inbounds": [
    {
      "type": "vless",
      "tag": "vless-reality-443",
      "listen": "::",
      "listen_port": 443,
      "users": [
        {
          "name": "alice",
          "uuid": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
          "flow": "xtls-rprx-vision"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "www.example.com",
        "reality": {
          "enabled": true,
          "handshake": {
            "server": "www.example.com",
            "server_port": 443
          },
          "private_key": "EBEREREREREREREREREREREREREREREREREREREREVE",
          "short_id": [
            "0123456789abcdef",
            "12345678"
          ]
        }
      }
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "shadowsocks",
      "tag": "bp-exit-probe-32-1",
      "server": "198.51.100.2",
      "server_port": 20000,
      "method": "2022-blake3-aes-256-gcm",
      "password": "ampqampqampqampqampqampqampqampqampqampqamo=",
      "connect_timeout": "4s"
    },
    {
      "routing_mark": 3070230529,
      "type": "direct",
      "tag": "direct-u1"
    }
  ],
  "route": {
    "rule_set": [
      {
        "type": "inline",
        "tag": "bp-exit-split",
        "rules": [
          {
            "domain": [
              "model.example.org"
            ],
            "domain_suffix": [
              "chatgpt.com"
            ],
            "ip_cidr": [
              "203.0.113.5/32",
              "2001:db8::5/128"
            ]
          },
          {
            "domain": [
              "api.example.com"
            ],
            "domain_suffix": [
              "bamgrid.com",
              "disney-plus.net",
              "disneyplus.com",
              "dssott.com",
              "example.net",
              "fast.com",
              "netflix.com",
              "netflix.net",
              "nflxext.com",
              "nflximg.com",
              "nflximg.net",
              "nflxso.net",
              "nflxvideo.net"
            ]
          }
        ]
      }
    ],
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "bittorrent",
        "action": "reject"
      },
      {
        "ip_is_private": true,
        "action": "reject",
        "inbound": [
          "vless-reality-443"
        ]
      },
      {
        "rule_set": [
          "bp-exit-split"
        ],
        "auth_user": [
          "alice"
        ],
        "action": "reject",
        "inbound": [
          "vless-reality-443"
        ]
      },
      {
        "action": "resolve",
        "server": "dns-local"
      },
      {
        "ip_is_private": true,
        "action": "reject"
      },
      {
        "auth_user": [
          "alice"
        ],
        "outbound": "direct-u1",
        "action": "route"
      }
    ],
    "final": "direct",
    "default_domain_resolver": "dns-local"
  },
  "experimental": {
    "clash_api": {
