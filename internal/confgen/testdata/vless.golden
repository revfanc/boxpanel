{
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "dns-local"
      }
    ],
    "final": "dns-local"
  },
  "inbounds": [
    {
      "type": "vless",
      "tag": "vless-reality-443",
      "listen": "::",
      "listen_port": 443,
      "users": [
        {
          "name": "alice",
          "uuid": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
          "flow": "xtls-rprx-vision"
        },
        {
          "name": "bob",
          "uuid": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb",
          "flow": "xtls-rprx-vision"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "www.example.com",
        "reality": {
          "enabled": true,
          "handshake": {
            "server": "www.example.com",
            "server_port": 443
          },
          "private_key": "EBEREREREREREREREREREREREREREREREREREREREVE",
          "short_id": [
            "0123456789abcdef",
            "12345678"
          ]
        }
      }
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "bittorrent",
        "action": "reject"
      },
      {
        "action": "resolve",
        "server": "dns-local"
      },
      {
        "ip_is_private": true,
        "action": "reject"
      }
    ],
    "final": "direct",
    "default_domain_resolver": "dns-local"
  },
  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:19090",
      "secret": "test-only-clash-secret"
    }
  }
}
