{
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "dns-local"
      }
    ],
    "final": "dns-local"
  },
  "inbounds": [
    {
      "type": "vless",
      "tag": "vless-reality-443",
      "listen": "::",
      "listen_port": 443,
      "users": [],
      "tls": {
        "enabled": true,
        "server_name": "www.example.com",
        "reality": {
          "enabled": true,
          "handshake": {
            "server": "www.example.com",
            "server_port": 443
          },
          "private_key": "EBEREREREREREREREREREREREREREREREREREREREVE",
          "short_id": [
            "0123456789abcdef",
            "12345678"
          ]
        }
      }
    },
    {
      "type": "hysteria2",
      "tag": "hy2-8443",
      "listen": "::",
      "listen_port": 8443,
      "users": [],
      "ignore_client_bandwidth": true,
      "tls": {
        "enabled": true,
        "alpn": [
          "h3"
        ],
        "certificate_path": "/etc/boxpanel/certs/hy2.crt",
        "key_path": "/etc/boxpanel/certs/hy2.key"
      }
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "bittorrent",
        "action": "reject"
      },
      {
        "action": "resolve",
        "server": "dns-local"
      },
      {
        "ip_is_private": true,
        "action": "reject"
      }
    ],
    "final": "direct",
    "default_domain_resolver": "dns-local"
  },
  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:19090",
      "secret": "test-only-clash-secret"
    }
  }
}
